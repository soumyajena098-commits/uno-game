{
  "name": "uno-multiplayer",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack real-time multiplayer UNO web application (React + Node.js + Socket.IO)",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "install-all": "npm install --prefix server && npm install --prefix client",
    "install:server": "npm install --prefix server",
    "install:client": "npm install --prefix client",
    "postinstall": "npm install --prefix server",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "build:server": "npm install --prefix server",
    "start": "node server.js",
    "test": "node server/src/test-engine.js"
  }
}
